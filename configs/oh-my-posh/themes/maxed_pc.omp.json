{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "upgrade": {
    "notice": true,
    "interval": "168h",
    "auto": true,
    "source": "cdn"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#465777",
          "template": "╭─"
        },
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "background": "#00d4d8",
          "foreground": "#ffffff",
          "template": " {{ .Icon }}  ",
          "options": {
            "archlinux": "",
            "fedoralinux": ""
          }
        },
        {
          "type": "shell",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "#00a5b5",
          "foreground": "#ffffff",
          "template": "  {{ .Name }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "#007a8a",
          "foreground": "#ffffff",
          "template": "  {{ .UserName }}@{{ .HostName }}   "
        },
        {
          "type": "root",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "#ef5350",
          "foreground": "#FFFB38",
          "template": "  ADMIN "
        },
        {
          "type": "path",
          "style": "diamond",
          "trailing_diamond": "",
          "background": "#001746",
          "foreground": "#E4E4E4",
          "options": {
            "style": "full",
            "folder_separator_icon": "/",
            "folder_icon": "",
            "home_icon": "~"
          },
          "template": "   {{ .Path }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "filler": "<#465777>─</>",
      "segments": [
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": "",
          "invert_powerline": true,
          "background": "#001746",
          "foreground": "#4caf50",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ef5350{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": " {{ if gt .Code 0 }} {{ reason .Code }}{{ else }}{{ end }}  "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "",
          "invert_powerline": true,
          "background": "#007a8a",
          "foreground": "#ffffff",
          "options": {
            "always_enabled": true,
            "threshold": 0
          },
          "template": "  {{ .FormattedMs }}  "
        },
        {
          "type": "time",
          "style": "diamond",
          "trailing_diamond": "",
          "invert_powerline": true,
          "background": "#001746",
          "foreground": "#E4E4E4",
          "template": "  {{ .CurrentDate | date \"Monday, 02-Jan-06 15:04:05 MST\" }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#465777",
          "template": "─╮"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#465777",
          "template": "├─"
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "#091d44",
          "foreground": "#ffffff",
          "template": "{{ if not .Segments.Git }}  Not a Git Repository {{ end }}"
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "#FFEB3B",
          "foreground": "#000000",
          "background_templates": [
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}#B388FF{{ end }}"
          ],
          "foreground_templates": [
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}#ffffff{{ end }}"
          ],
          "options": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ if contains \"github\" .UpstreamURL }} {{ else if contains \"gitlab\" .UpstreamURL }} {{ else if contains \"bitbucket\" .UpstreamURL }} {{ else }} {{ end }}{{ .HEAD }}{{ if gt .Behind 0 }} {{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} {{ .Ahead }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true,
            "fetch_package_manager": true,
            "npm_icon": " <#cc3a3a></>",
            "yarn_icon": " <#348cba></>"
          },
          "template": " <#689f63></>{{ if .PackageManagerIcon }}{{ .PackageManagerIcon }}{{ end }} {{ .Full }} "
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true,
            "display_mode": "context"
          },
          "template": " <#FFDE57></> {{ .Full }}{{ if .Venv }} ({{ .Venv }}){{ end }} "
        },
        {
          "type": "java",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#f89820></> {{ .Full }} "
        },
        {
          "type": "go",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#00acd7></> {{ .Full }} "
        },
        {
          "type": "dotnet",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#512bd4></> {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#f74c00></> {{ .Full }} "
        },
        {
          "type": "docker",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "display_mode": "files",
            "fetch_context": true
          },
          "template": " <#2496ed></> {{ .Context }} "
        },
        {
          "type": "npm",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#cb3837></> {{ .Full }} "
        },
        {
          "type": "pnpm",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#f9ad00></> {{ .Full }} "
        },
        {
          "type": "yarn",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#2c8ebb></> {{ .Full }} "
        },
        {
          "type": "bun",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#fbf0df></> {{ .Full }} "
        },
        {
          "type": "aws",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "display_default": false
          },
          "template": " <#ff9900></> {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} "
        },
        {
          "type": "kubectl",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "parse_kubeconfig": true
          },
          "template": " <#326ce5>󱃾</> {{ .Context }}{{ if .Namespace }} :: {{ .Namespace }}{{ end }} "
        },
        {
          "type": "terraform",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {},
          "template": " <#844fba>󱁢</> {{ .WorkspaceName }} "
        },
        {
          "type": "php",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#777bb4></> {{ .Full }} "
        },
        {
          "type": "ruby",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#cc342d></> {{ .Full }} "
        },
        {
          "type": "lua",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#51a0cf></> {{ .Full }} "
        },
        {
          "type": "cmake",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#008fba></> {{ .Full }} "
        },
        {
          "type": "kotlin",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#7f52ff></> {{ .Full }} "
        },
        {
          "type": "dart",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#1e2636",
          "foreground": "#ffffff",
          "options": {
            "fetch_version": true
          },
          "template": " <#40c4ff></> {{ .Full }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#465777",
          "template": "│"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#465777",
          "template": "╰─"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#e0f8ff",
          "template": "❯"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "sysinfo",
          "style": "diamond",
          "leading_diamond": "",
          "background": "#1abba5",
          "foreground": "#ffffff",
          "options": {
            "precision": 0
          },
          "template": "  CPU: {{ round .PhysicalPercentUsed .Precision }}% |  MEM: {{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB "
        },
        {
          "type": "connection",
          "style": "powerline",
          "invert_powerline": true,
          "background": "#14a3a8",
          "foreground": "#ffffff",
          "options": {
            "type": "wifi"
          },
          "template": " {{ if eq .Type \"wifi\"}}{{ else if eq .Type \"ethernet\"}}{{ else }}{{ end }}  {{ .Name }} ",
          "powerline_symbol": ""
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#14a3a8",
          "template": ""
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#465777",
          "template": "─╯"
        }
      ]
    }
  ]
}